# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings → API). O .env não vai para o Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "publishable" (ou "anon"). NUNCA a "secret" / "service_role".
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
