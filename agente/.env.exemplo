# Copie para agente/.env e preencha. O .env não vai para o Git.
NETBOX_URL=https://netbox.suaempresa.local
# NetBox > Admin > API Tokens (somente leitura basta)
NETBOX_TOKEN=
# Porta do agente (o editor usa http://localhost:8787 por padrão)
PORTA=8787
# Sites que podem usar o agente, separados por vírgula
ORIGENS=https://thegrafo.vercel.app,http://localhost:3000
# Opcional: senha que o editor envia no campo "Chave do agente"
AGENTE_CHAVE=
